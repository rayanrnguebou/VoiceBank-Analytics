# ═════════════════════════════════════════════════════════════
# VoiceBank Analytics — variables pour docker compose
# cp .env.example .env  (le fichier .env n'est JAMAIS commité)
# Mets les valeurs contenant des $ entre apostrophes simples.
# ═════════════════════════════════════════════════════════════

# Mots de passe base de données (longs et différents)
POSTGRES_ADMIN_USER=voicebank_admin
POSTGRES_ADMIN_PASSWORD=
VOICEBANK_APP_PASSWORD=
VOICEBANK_READER_PASSWORD=

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Premier administrateur (nom:role:hash). Les autres comptes se créent dans l'interface
# (Administration → Comptes). Hash : python -m app.outils.creer_hash (voir README)
VOICEBANK_USERS='rayan:admin:$2b$12$REMPLACE_PAR_TON_HASH'

ALLOWED_ORIGINS=http://localhost:3000
REACT_APP_API_URL=http://localhost:8000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=

# Whisper local (dossier voicebank_whisper) : utilisé si GROQ_API_KEY est vide ou si Groq échoue
WHISPER_LOCAL=auto
WHISPER_LOCAL_MODELE=base

# Offre publique (essai gratuit + abonnements). Prix en FCFA.
ESSAI_JOURS=3
PRIX_JOUR=500
PRIX_SEMAINE=2000
PRIX_MOIS=6000
PRIX_ANNEE=60000
# Paiement NotchPay (business.notchpay.co → Settings → API Keys). Vide : paiement désactivé.
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_HASH_KEY=
URL_INTERFACE=http://localhost:3000
# true : simule le paiement en local, sans compte marchand (refusé sur Render et avec une vraie clé)
PAIEMENT_SIMULATION=false
# E-mails « mot de passe oublié » (code à 6 chiffres). Vide : récupération par l'administrateur uniquement.
# Option 1 (recommandée, marche aussi sur Render) : Brevo, 300 e-mails/jour gratuits.
BREVO_API_KEY=
EMAIL_EXPEDITEUR=
# Option 2 : SMTP (ex. Gmail : smtp.gmail.com, port 587, « mot de passe d'application » Google)
SMTP_HOTE=
SMTP_PORT=587
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
# Signature des e-mails et adresse de réponse (par défaut : l'expéditeur)
EMAIL_SIGNATURE_NOM=Rayan Nguebou Temgoua
EMAIL_SIGNATURE_FONCTION=Fondateur, VoiceBank Analytics
EMAIL_CONTACT=
# Comptes inclus dans l'abonnement d'une organisation (administrateur compris)
COMPTES_JOUR=3
COMPTES_SEMAINE=3
COMPTES_MOIS=10
COMPTES_ANNEE=25

# Connecteur (bases des organisations). Clé longue et secrète qui chiffre les identifiants de
# connexion : python -c "import secrets; print(secrets.token_urlsafe(48))". Ne la change plus ensuite.
CLE_SOURCES=
# true : autorise les bases du réseau local (en ligne : false). Base sur ce PC : hôte host.docker.internal
CONNECTEUR_RESEAU_PRIVE=true

# pgAdmin (profil "admin" uniquement)
PGADMIN_EMAIL=admin@voicebank.local
PGADMIN_PASSWORD=
