# ═════════════════════════════════════════════════════════════
# VoiceBank Analytics — API : variables d'environnement
# Copie ce fichier en .env (jamais commité) et remplis les valeurs.
# ═════════════════════════════════════════════════════════════
ENV=development

# Compte applicatif (lecture + journaux) et compte LECTURE SEULE (SQL généré)
DATABASE_URL=postgresql://voicebank_app:CHANGE_MOI@localhost:5432/voicebank_db
READONLY_DATABASE_URL=postgresql://voicebank_reader:CHANGE_MOI@localhost:5432/voicebank_db

# Sécurité
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_DUREE_MIN=60
# Comptes nom:role:hash_bcrypt (role = analyste ou admin), séparés par des virgules
# Générer un hash : python -m app.outils.creer_hash
VOICEBANK_USERS=
ALLOWED_ORIGINS=http://localhost:3000

# IA
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=

# Whisper local (dossier voicebank_whisper) : utilisé si GROQ_API_KEY est vide ou si Groq échoue
WHISPER_LOCAL=auto
WHISPER_LOCAL_MODELE=base
